# =============================================================================
# IGL VisionGuard - DEVELOPMENT environment template
# =============================================================================
# Local development defaults. Authentication is DISABLED here so the dashboard
# opens directly without a login. For production see .env.production.example,
# which enforces ENABLE_AUTH=true and strong secrets.
# =============================================================================
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=igl_safety.db
ENABLE_AUTH=false
SECRET_KEY=dev-only-igl-secret-change-in-production
ACCESS_TOKEN_TTL_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-login
ADMIN_EMAIL=

EVIDENCE_DIR=evidence
REPORTS_DIR=reports
MODEL_DIR=models
IGL_DATA_DIR=data
MAX_UPLOAD_BYTES=26214400
MAX_EVIDENCE_IMAGE_BASE64=8388608

CAMERA_RECONNECT_MAX_ATTEMPTS=5
CAMERA_READ_TIMEOUT_SECONDS=5
LEAKAGE_MIN_FRAMES=3
LEAKAGE_COOLDOWN_SECONDS=180
ALERT_DEDUP_SECONDS=120

YOLO_MODEL_PATH=yolov8n.pt
LEAKAGE_BASE_WEIGHTS=yolov8n.pt

WHATSAPP_MODE=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
CONTROLLER_WHATSAPP_NUMBER=
WHATSAPP_TEMPLATE_NAME=igl_unknown_person_alert
WHATSAPP_TEMPLATE_LANG=en_US

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER=IGL
ALERT_SMS_TO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ROBOFLOW_API_KEY=