ENVIRONMENT=development
ALLOW_ANONYMOUS_ACCESS=true
# For shared deployments set false and provide a random 32+ byte JWT signing key.
AUTH_JWT_SECRET_KEY=
AUTH_JWT_ISSUER=igl-safety-intelligence
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional one-time admin bootstrap; leave all four empty after first setup.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_PASSWORD=
# SQLite is rejected automatically outside development/test. Production example:
# DATABASE_URL=postgresql+psycopg://igl_safety:CHANGE_ME@db.internal:5432/igl_safety
DATABASE_URL=sqlite:///data/database.db
BACKEND_CORS_ORIGINS=["http://localhost:8001","http://127.0.0.1:8001"]

# Optional operator-supplied sources; no media or weights are downloaded.
VIDEO_SOURCE=
RTSP_URL=
CAMERA_URL_ENCRYPTION_KEY=
MODEL_WEIGHTS_PATH=
MODEL_NAME=
MODEL_VERSION=
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_DEVICE=cpu
MODEL_IOU_THRESHOLD=0.7
MODEL_IMAGE_SIZE=640
# Local discovery only: scans the listed directories for a checkpoint an
# operator already placed there. It never downloads and never auto-activates.
MODEL_AUTO_DISCOVER=false
MODEL_SEARCH_PATHS=[]
MODEL_SEARCH_MAX_DEPTH=3
MODEL_VALIDATION_WARMUP_PASSES=2
MODEL_VALIDATION_TIMED_PASSES=5
CAMERA_TARGET_FPS=0
FRAME_BUFFER_RETENTION_SECONDS=30
FRAME_BUFFER_MAX_FRAMES=100
FRAME_BUFFER_MAX_BYTES=67108864
CAMERA_HEALTH_INTERVAL_SECONDS=5
EVIDENCE_DIR=data/evidence
EVIDENCE_RETENTION_DAYS=0
SAFETY_EVENT_WORKER_ENABLED=false
SAFETY_RULE_DEBOUNCE_SECONDS=5
SAFETY_RULE_COOLDOWN_SECONDS=60

# Optional real notification transports. Leave empty until operator-approved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
NOTIFICATION_FROM_ADDRESS=
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_RECIPIENTS=[]
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_RECIPIENTS=[]
WHATSAPP_TIMEOUT_SECONDS=10

# Message templates. Placeholders come from real event facts only; an unknown
# placeholder is reported as NOT_SUBSTITUTED rather than silently filled.
EMAIL_INCIDENT_SUBJECT_TEMPLATE={severity} safety event: {event_type}
EMAIL_INCIDENT_BODY_TEMPLATE=
EMAIL_ESCALATION_SUBJECT_TEMPLATE=ESCALATED {severity} safety event: {event_type}
EMAIL_ESCALATION_BODY_TEMPLATE=
EMAIL_TEST_BODY_TEMPLATE=IGL Safety Intelligence operator test message.
WHATSAPP_INCIDENT_TEMPLATE=
WHATSAPP_ESCALATION_TEMPLATE=
WHATSAPP_TEST_TEMPLATE=IGL Safety Intelligence operator test message.

# Software alarm policy. An alarm is only ever raised from a confirmed event.
ALARM_ENABLED=true
ALARM_MIN_SEVERITY=MEDIUM
ALARM_COOLDOWN_SECONDS=120
ALARM_MAX_REPEATS_PER_WINDOW=3
ALARM_REPEAT_WINDOW_SECONDS=900
ALARM_AUTO_EXPIRE_SECONDS=1800
ALARM_AUDIBLE_BROWSER=true
# Physical actuation is reported as PHYSICAL_ALARM_NOT_CONFIGURED until a real
# transport below is configured AND real hardware answers.
ALARM_PHYSICAL_ACTUATION=false
PHYSICAL_ALARM_HTTP_URL=
PHYSICAL_ALARM_HTTP_METHOD=POST
PHYSICAL_ALARM_HTTP_BEARER_TOKEN=
PHYSICAL_ALARM_HTTP_TIMEOUT_SECONDS=5
PHYSICAL_ALARM_MQTT_HOST=
PHYSICAL_ALARM_MQTT_PORT=1883
PHYSICAL_ALARM_MQTT_TOPIC=
PHYSICAL_ALARM_MQTT_USERNAME=
PHYSICAL_ALARM_MQTT_PASSWORD=
PHYSICAL_ALARM_MQTT_USE_TLS=false
PHYSICAL_ALARM_SERIAL_PORT=
PHYSICAL_ALARM_SERIAL_BAUD=9600
PHYSICAL_ALARM_SERIAL_PULSE_SECONDS=2
PHYSICAL_ALARM_GPIO_PIN=0
PHYSICAL_ALARM_GPIO_ACTIVE_HIGH=true

# System health thresholds. Disk is reported from a real volume measurement.
HEALTH_DISK_PATH=
HEALTH_DISK_MIN_FREE_BYTES=536870912
HEALTH_DISK_MIN_FREE_PERCENT=5
