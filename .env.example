ENVIRONMENT=development
ALLOW_ANONYMOUS_ACCESS=true
# For shared deployments set false and provide a random 32+ byte JWT signing key.
AUTH_JWT_SECRET_KEY=
AUTH_JWT_ISSUER=igl-safety-intelligence
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional one-time admin bootstrap; leave all four empty after first setup.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_PASSWORD=
DATABASE_URL=sqlite:///data/database.db
BACKEND_CORS_ORIGINS=["http://localhost:8001","http://127.0.0.1:8001"]

# Optional operator-supplied sources; no media or weights are downloaded.
VIDEO_SOURCE=
RTSP_URL=
CAMERA_URL_ENCRYPTION_KEY=
MODEL_WEIGHTS_PATH=
MODEL_NAME=
MODEL_VERSION=
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_DEVICE=cpu
CAMERA_TARGET_FPS=0
FRAME_BUFFER_RETENTION_SECONDS=30
FRAME_BUFFER_MAX_FRAMES=100
FRAME_BUFFER_MAX_BYTES=67108864
CAMERA_HEALTH_INTERVAL_SECONDS=5
EVIDENCE_DIR=data/evidence
EVIDENCE_RETENTION_DAYS=0
SAFETY_EVENT_WORKER_ENABLED=false

# Optional real notification transports. Leave empty until operator-approved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
NOTIFICATION_FROM_ADDRESS=
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_RECIPIENTS=[]
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_RECIPIENTS=[]
WHATSAPP_TIMEOUT_SECONDS=10
