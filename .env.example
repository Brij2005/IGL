ENVIRONMENT=development
ALLOW_ANONYMOUS_ACCESS=true
DATABASE_URL=sqlite:///data/database.db
BACKEND_CORS_ORIGINS=["http://localhost:8001","http://127.0.0.1:8001"]

# Optional operator-supplied sources; no media or weights are downloaded.
VIDEO_SOURCE=
RTSP_URL=
CAMERA_URL_ENCRYPTION_KEY=
MODEL_WEIGHTS_PATH=
MODEL_NAME=
MODEL_VERSION=
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_DEVICE=cpu
CAMERA_TARGET_FPS=0
FRAME_BUFFER_RETENTION_SECONDS=30
FRAME_BUFFER_MAX_FRAMES=100
FRAME_BUFFER_MAX_BYTES=67108864
CAMERA_HEALTH_INTERVAL_SECONDS=5
EVIDENCE_DIR=data/evidence
EVIDENCE_RETENTION_DAYS=0
SAFETY_EVENT_WORKER_ENABLED=false
