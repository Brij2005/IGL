ENVIRONMENT=development
# Development-only default. Production startup rejects this value and requires
# a unique SECRET_KEY of at least 32 characters from a secret manager.
SECRET_KEY=development-only-secret-change-before-production-2026
DATABASE_URL=sqlite:///data/database.db
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
MINIMUM_ADMIN_PASSWORD_LENGTH=12
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.1:5500"]

# First-administrator bootstrap. Disabled by default. Startup never creates an
# administrator. To bootstrap non-interactively, set BOOTSTRAP_ADMIN_ENABLED=true
# and supply every value below, then remove them once the account exists.
# There is no default password and no fallback credential.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Phase 4 inference inputs. Empty values mean UNCONFIGURED; weights are never
# downloaded and no source is invented.
VIDEO_SOURCE=
RTSP_URL=
CAMERA_URL_ENCRYPTION_KEY=
MODEL_WEIGHTS_PATH=
MODEL_NAME=
MODEL_VERSION=
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_DEVICE=cpu
FRAME_BUFFER_RETENTION_SECONDS=30
FRAME_BUFFER_MAX_FRAMES=100
FRAME_BUFFER_MAX_BYTES=67108864
CAMERA_HEALTH_INTERVAL_SECONDS=5
EVIDENCE_DIR=data/evidence
