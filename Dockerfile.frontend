# IGL VisionGuard - Frontend image (production static build served by nginx)
#
# Build:  docker build -f Dockerfile.frontend -t igl-visionguard-frontend .
#
# Stage 1 builds the Vite bundle. Stage 2 serves it with nginx and proxies
# /api to the backend service so the browser only ever talks to one origin.

FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# The API base is same-origin: nginx proxies /api to the backend container.
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

FROM nginx:1.27-alpine AS runtime

# Remove the default site so only our configuration is active.
RUN rm /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/conf.d/igl.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]